root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,c,h}]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4
